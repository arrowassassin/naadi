# Naadi environment variables. NAMES ONLY: never put real values in this file.
#
# Precedence (naadi_api/settings.py, scripts/check_env.py):
#   1. Process environment (Claude Code cloud environment, HF Space secrets/variables, GitHub Actions secrets)
#   2. `.env` in the repo root, for local development only (gitignored)
#
# [secret]  = keep private. HF Space *secret*, GitHub Actions *secret*.
# [public]  = safe to expose to the browser or logs. HF Space *variable*.
# [config]  = non-secret server config. HF Space *variable*.
# See docs/SECRETS.md for the full source → HF → GitHub mapping.

# ───────────── Supabase (https://supabase.com/dashboard → your project) ─────────────
# [secret] Project Settings → Database → Connection string → "Session pooler" (port 5432).
#          Append ?sslmode=require. Format: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# [public] Project Settings → API → Project URL (https://<ref>.supabase.co)
SUPABASE_URL=
# [public] Project Settings → API Keys → anon / publishable key (RLS still applies)
SUPABASE_ANON_KEY=
# [secret] Project Settings → API Keys → service_role / secret key. Bypasses RLS: server only, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# [secret] Project Settings → JWT Keys → Legacy JWT secret. Leave empty if the project uses asymmetric
#          signing keys only; the API then verifies tokens via <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
# [secret] Build-session only (NOT pushed to the Space or GitHub). supabase.com → Account preferences → Access Tokens (sbp_…).
#          Lets the cloud build sandbox run SQL over the HTTPS Management API, since raw Postgres can't leave the sandbox.
SUPABASE_ACCESS_TOKEN=
# [public] Same values as SUPABASE_URL / SUPABASE_ANON_KEY, read by Vite at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────────── AI ─────────────
# [secret] https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# [config] 50 until lifetime credit purchases reach $10 (one-time purchase), then 1000
OPENROUTER_DAILY_CAP=
# [config] Sent as HTTP-Referer / X-Title for OpenRouter attribution, e.g. https://<ns>-naadi.hf.space and Naadi
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=
# [secret] https://app.tavily.com → API Keys (free plan: 1,000 credits/month)
TAVILY_API_KEY=

# ───────────── Hugging Face (https://huggingface.co/settings/tokens) ─────────────
# [secret] Access token with WRITE role (deploys the Space, pushes backups)
HF_TOKEN=
# [config] Space repo id, e.g. arrowassassin/naadi
HF_SPACE_ID=
# [config] PRIVATE dataset repo for nightly pg_dump backups, e.g. arrowassassin/naadi-backups
HF_BACKUP_DATASET=

# ───────────── Auth / admin ─────────────
# [config] Comma-separated emails that get the admin (content review) role
ADMIN_EMAILS=
# [config] true once Google is enabled in Supabase → Authentication → Providers. The Google client ID/secret live only in Supabase.
GOOGLE_OAUTH_CONFIGURED=

# ───────────── Optional (later milestones) ─────────────
# [secret] https://console.cloud.google.com → APIs & Services → Credentials (YouTube Data API v3), used by youtube_mapper (M6)
YOUTUBE_API_KEY=
# Cloudflare dashboard → R2 → Manage API tokens (large uploads, own videos; M5)
# [config] Account ID
R2_ACCOUNT_ID=
# [secret] R2 API token access key id / secret
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# [config] Bucket name and its public base URL (r2.dev or custom domain)
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ───────────── App ─────────────
# [config] local | staging | prod
APP_ENV=
# [config] Public base URL of the app, e.g. http://localhost:5173 or https://<ns>-naadi.hf.space
APP_BASE_URL=
# [config] DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
