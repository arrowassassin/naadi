{
  "components": {
    "schemas": {
      "ComponentHealth": {
        "properties": {
          "cached": {
            "description": "True when served from the check cache",
            "title": "Cached",
            "type": "boolean"
          },
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "detail": {
            "description": "Short human-readable summary, never secret material",
            "maxLength": 240,
            "title": "Detail",
            "type": "string"
          },
          "free_tier": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "OpenRouter only: account has no credit purchase",
            "title": "Free Tier"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Time the check took; None if it could not run",
            "title": "Latency Ms"
          },
          "quota": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Quota"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "latency_ms",
          "detail",
          "checked_at",
          "cached"
        ],
        "title": "ComponentHealth",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code, e.g. not_found, validation_error",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Present for validation errors",
            "title": "Details"
          },
          "message": {
            "description": "Human-readable message, safe to show to the user",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Echoes the X-Request-ID response header",
            "title": "Request Id"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthComponents": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "openrouter": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "storage": {
            "$ref": "#/components/schemas/ComponentHealth"
          },
          "tavily": {
            "$ref": "#/components/schemas/ComponentHealth"
          }
        },
        "required": [
          "database",
          "storage",
          "openrouter",
          "tavily"
        ],
        "title": "HealthComponents",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "components": {
            "$ref": "#/components/schemas/HealthComponents"
          },
          "environment": {
            "enum": [
              "local",
              "staging",
              "prod"
            ],
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "environment",
          "checked_at",
          "components"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Quota": {
        "properties": {
          "guard": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Our own stop point below the provider limit",
            "title": "Guard"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "None when the provider reports no limit",
            "title": "Limit"
          },
          "period": {
            "enum": [
              "day",
              "month"
            ],
            "title": "Period",
            "type": "string"
          },
          "remaining": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining"
          },
          "unit": {
            "enum": [
              "requests",
              "credits"
            ],
            "title": "Unit",
            "type": "string"
          },
          "used": {
            "minimum": 0.0,
            "title": "Used",
            "type": "integer"
          }
        },
        "required": [
          "used",
          "limit",
          "remaining",
          "unit",
          "period"
        ],
        "title": "Quota",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "title": "Checks",
            "type": "object"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready",
          "checks"
        ],
        "title": "ReadyResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Naadi API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "The database is down"
          }
        },
        "summary": "System health: database, storage, OpenRouter quota, Tavily credits",
        "tags": [
          "system"
        ]
      }
    },
    "/api/ready": {
      "get": {
        "operationId": "getReady",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness: settings loaded and the database pool can hand out a connection",
        "tags": [
          "system"
        ]
      }
    }
  }
}
