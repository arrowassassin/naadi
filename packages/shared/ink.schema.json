{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maxItems": 20000,
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["ink", "violet", "lime", "amber"]
              },
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            ]
          },
          "anchor": {
            "type": "object",
            "properties": {
              "pm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dx": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "dy": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "fp": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,30}:[0-9a-f]{8}$"
              }
            },
            "required": ["pm"],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deleted": {
            "type": "boolean",
            "const": true
          },
          "tool": {
            "type": "string",
            "enum": ["pen", "marker"]
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.1
          },
          "points": {
            "minItems": 1,
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "minimum": -10000,
                  "maximum": 10000
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400000
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          },
          "shape": {
            "type": "string",
            "enum": ["line", "arrow", "circle", "ellipse", "rect"]
          }
        },
        "required": ["id", "color", "createdAt", "updatedAt", "tool", "size", "points"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "color": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["ink", "violet", "lime", "amber"]
              },
              {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            ]
          },
          "anchor": {
            "type": "object",
            "properties": {
              "pm": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "dx": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "dy": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "fp": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]{0,30}:[0-9a-f]{8}$"
              }
            },
            "required": ["pm"],
            "additionalProperties": false
          },
          "createdAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deleted": {
            "type": "boolean",
            "const": true
          },
          "tool": {
            "type": "string",
            "const": "text"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.2
          },
          "x": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "y": {
            "type": "number",
            "minimum": -10000,
            "maximum": 10000
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 4
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["id", "color", "createdAt", "updatedAt", "tool", "size", "x", "y", "w", "text"],
        "additionalProperties": false
      }
    ]
  }
}
